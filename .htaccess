# 云湖反馈机器人 - Apache 路由规则
# 需开启 mod_rewrite

RewriteEngine On

# 点赞接口 /feedback/{编号}/like（放在前面，优先匹配）
RewriteRule ^feedback/([A-Za-z0-9\-]+)/like/?$ feedback.php?no=$1&like=1 [L,QSA]

# 反馈详情页 /feedback/{编号}
RewriteRule ^feedback/([A-Za-z0-9\-]+)/?$ feedback.php?no=$1 [L,QSA]

# 反馈列表页 /feedback
RewriteRule ^feedback/?$ feedback.php [L,QSA]

# 管理后台 /fb-admin
RewriteRule ^fb-admin/?$ fb-admin.php [L,QSA]
